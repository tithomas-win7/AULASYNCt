NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://aulasync_app:REEMPLAZAR_CLAVE_LOCAL@127.0.0.1:5432/aulasync_dev?schema=public
# Generar una vez un secreto aleatorio de al menos 32 caracteres. No rotarlo al reiniciar.
SESSION_SECRET=
# Exclusivamente fixtures locales. Generar una clave aleatoria; nunca usar en produccion.
SEED_PASSWORD=

# Origen exacto de la interfaz; no agregar barra final.
APP_ORIGIN=http://127.0.0.1:5173
SESSION_TTL_HOURS=8

# Sprint 5. El modo mock se limita a desarrollo y pruebas.
AI_PROVIDER=mock
# Para Ollama local, usar AI_PROVIDER=ollama y configurar URL y modelo.
# AI_BASE_URL=http://127.0.0.1:11435
# AI_MODEL=qwen2.5:0.5b
# AI_API_KEY se usa únicamente con un proveedor HTTPS remoto.
